        <mxCell id="d_k1" value="&lt;b&gt;K1. Kontrola&lt;/b&gt;&lt;br&gt;czas od ostatniego komunikatu (wg czasu odebrania w chmurze)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#dae8fc;strokeColor=#3d6aa8;dashed=1;dashPattern=6 3;strokeWidth=1.5;fontSize=10.5;" vertex="1" parent="1">
