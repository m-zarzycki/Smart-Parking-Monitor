        <mxCell id="a_sim" value="&lt;b&gt;Symulator czujników&lt;/b&gt; (Python)&lt;br&gt;F01: komunikaty ZMIANA i HEARTBEAT dla 90 miejsc, reguła 3 s, heartbeat co 60 s&lt;br&gt;&lt;i&gt;start ręczny przed testem&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#dae8fc;strokeColor=#3d6aa8;dashed=1;dashPattern=6 3;strokeWidth=1.5;" vertex="1" parent="1">
