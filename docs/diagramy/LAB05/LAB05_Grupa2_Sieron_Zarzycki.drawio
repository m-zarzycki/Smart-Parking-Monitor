        </mxCell>
        <mxCell id="d_k3" value="&lt;b&gt;K3. Zarządca&lt;/b&gt; widzi alert w panelu, potwierdza go i zleca naprawę czujnika &lt;i&gt;(krok ręczny)&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#fff2cc;strokeColor=#b8962e;dashed=1;dashPattern=6 3;strokeWidth=1.5;fontSize=10;" vertex="1" parent="1">
