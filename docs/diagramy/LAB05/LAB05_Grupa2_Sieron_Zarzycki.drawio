        <mxCell id="d_lane" value="Alarm F05: kontrola braku danych (funkcja Kontrola, co 10 s, niezależnie od rekordów)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fillColor=none;strokeColor=#7a7a7a;strokeWidth=1.2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#4a4a4a;" vertex="1" parent="1">
