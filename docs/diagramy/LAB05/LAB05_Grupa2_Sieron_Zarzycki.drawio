        <mxCell id="przeplyw_e19" value="alert" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;strokeWidth=1.3;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_k2" target="d_k3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_sit" value="&lt;table style='border-collapse:collapse;width:100%;font-size:10px' border='1' cellpadding='3'&gt;&lt;tr style='background:#e8eef7'&gt;&lt;th style='width:24%'&gt;Sytuacja&lt;/th&gt;&lt;th&gt;Co się dzieje&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Prawidłowy rekord&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Odbiornik zapisuje go w Azure SQL (Miejsca, Historia zmian); kierowca widzi nowy licznik na tablicy i mapie w ciągu 5 s.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Błędna wartość lub brak czasu&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Odbiornik odrzuca rekord i zapisuje go w Odrzucone komunikaty z powodem; stan miejsca i licznik bez zmian.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Brak połączenia / nowych danych&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Bufor na ESP32 nie jest założony (ograniczenie prototypu). Po 3 min: BRAK DANYCH, szare miejsce, 1 alert; mapa pokazuje czas ostatniej aktualizacji. Po powrocie sieci heartbeat (≤ 60 s) przywraca stan i zamyka alert.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=2;fontSize=11;fontSize=10;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="615" width="565" height="150" as="geometry" />
        </mxCell>
        <mxCell id="d_rec" value="&lt;b&gt;Przykład rekordu (krok 2, scenariusz 1 z LAB02):&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;{&quot;spot_id&quot;:&quot;B03&quot;, &quot;zone&quot;:&quot;B&quot;, &quot;state&quot;:&quot;ZAJĘTE&quot;, &quot;distance_cm&quot;:60,&lt;br&gt;&amp;nbsp;&quot;msg_type&quot;:&quot;ZMIANA&quot;, &quot;event_time_utc&quot;:&quot;2026-11-24T08:00:03Z&quot;}&lt;/font&gt;&amp;nbsp;&amp;nbsp;(09:00:03 czasu lokalnego)&lt;br&gt;&lt;b&gt;Rekord błędny:&lt;/b&gt; spot_id spoza A01–C30, zone niezgodna z miejscem, state inny niż ZAJĘTE/WOLNE, msg_type inny niż ZMIANA/HEARTBEAT, brak event_time_utc lub czas &amp;gt; 1 min w przyszłości, distance_cm &amp;lt; 0 lub &amp;gt; 450." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fillColor=#f7f7f7;strokeColor=#bdbdbd;align=left;verticalAlign=top;spacing=6;fontSize=10.5;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="712" width="550" height="82" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
