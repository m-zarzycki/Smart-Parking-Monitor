        <mxCell id="a_hub" value="&lt;b&gt;Azure IoT Hub&lt;/b&gt; (Free F1)&lt;br&gt;F02: przyjmuje komunikaty,&lt;br&gt;rejestr tożsamości urządzeń" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#dae8fc;strokeColor=#3d6aa8;dashed=1;dashPattern=6 3;strokeWidth=1.5;" vertex="1" parent="1">
