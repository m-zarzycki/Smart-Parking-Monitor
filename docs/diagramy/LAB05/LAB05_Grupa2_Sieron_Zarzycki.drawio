        </mxCell>
        <mxCell id="d_k2" value="&lt;b&gt;K2. BRAK DANYCH&lt;/b&gt;&lt;br&gt;stan + wpis w historii; 1 alert (jeśli brak aktywnego); miejsce szare, nie liczy się jako wolne" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#dae8fc;strokeColor=#3d6aa8;dashed=1;dashPattern=6 3;strokeWidth=1.5;fontSize=10;" vertex="1" parent="1">
