        <mxCell id="a_rcv" value="&lt;b&gt;Funkcja Odbiornik&lt;/b&gt;&lt;br&gt;(Azure Functions, wyzwalacz IoT Hub)&lt;br&gt;F02: waliduje rekord, porównuje stan z bazą, zapisuje" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#dae8fc;strokeColor=#3d6aa8;dashed=1;dashPattern=6 3;strokeWidth=1.5;" vertex="1" parent="1">
