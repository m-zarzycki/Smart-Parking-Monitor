        <mxCell id="lok_lg3" value="odrzucenie / błąd" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=10;spacing=1;" vertex="1" parent="1">
          <mxGeometry x="980" y="60" width="170" height="22" as="geometry" />
        </mxCell>
        <mxCell id="lok_fr_pc" value="KOMPUTER ZESPOŁU (Docker + Python 3.11) • broker dostępny tylko z localhost" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=none;strokeColor=#7a7a7a;strokeWidth=1.2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#4a4a4a;" vertex="1" parent="1">
          <mxGeometry x="18" y="100" width="1134" height="420" as="geometry" />
        </mxCell>
        <mxCell id="lok_fr_br" value="PRZEGLĄDARKA UŻYTKOWNIKA" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=none;strokeColor=#7a7a7a;strokeWidth=1.2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#4a4a4a;" vertex="1" parent="1">
          <mxGeometry x="692" y="560" width="460" height="210" as="geometry" />
        </mxCell>
        <mxCell id="lok_sim" value="&lt;b&gt;Symulator czujników&lt;/b&gt;&lt;br&gt;python -m simulator&lt;br&gt;F01: 90 × logika ESP32&lt;br&gt;(7 odczytów = 3 s),&lt;br&gt;ZMIANA + HEARTBEAT 60 s,&lt;br&gt;brak bufora" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#d5e8d4;strokeColor=#5b8f45;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="36" y="135" width="190" height="125" as="geometry" />
        </mxCell>
        <mxCell id="lok_esp" value="&lt;b&gt;ESP32 + JSN-SR04T&lt;/b&gt;&lt;br&gt;&lt;i&gt;firmware/esp32_czujnik&lt;/i&gt;&lt;br&gt;ta sama reguła 3 s&lt;br&gt;login MQTT = id miejsca" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#dae8fc;strokeColor=#3d6aa8;dashed=1;dashPattern=6 3;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="36" y="330" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="lok_mq" value="&lt;b&gt;Broker Mosquitto 2&lt;/b&gt;&lt;br&gt;(Docker)&lt;br&gt;F02: przyjmuje komunikaty&lt;br&gt;temat parking/{strefa}/{miejsce}&lt;br&gt;logowanie + ACL, QoS 1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#d5e8d4;strokeColor=#5b8f45;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="345" y="140" width="200" height="115" as="geometry" />
        </mxCell>
        <mxCell id="lok_rcv" value="&lt;b&gt;Odbiornik&lt;/b&gt;&lt;br&gt;python -m parking start&lt;br&gt;MqttReceiver →&lt;br&gt;ParkingService.handle_message&lt;br&gt;F02: walidacja, porównanie z bazą,&lt;br&gt;zapis, zamknięcie alertu" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#d5e8d4;strokeColor=#5b8f45;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="660" y="132" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="lok_lim" value="&lt;b&gt;Dlaczego wariant lokalny?&lt;/b&gt; IoT Hub F1 = 8 000 komunikatów na dobę, a 90 czujników × heartbeat co 60 s to ok. 130 000. Pełne testy 90 miejsc i scenariusz 3 (20 min) robimy lokalnie." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fillColor=#f7f7f7;strokeColor=#bdbdbd;align=left;verticalAlign=top;spacing=6;fontSize=10.5;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="945" y="135" width="195" height="125" as="geometry" />
        </mxCell>
        <mxCell id="lok_chk" value="&lt;b&gt;Kontrola braku danych&lt;/b&gt;&lt;br&gt;wątek SilenceChecker co 10 s&lt;br&gt;F05: &amp;gt; 3 min → BRAK DANYCH&lt;br&gt;+ 1 alert; co 5 min&lt;br&gt;próbka obłożenia" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#d5e8d4;strokeColor=#5b8f45;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="345" y="345" width="200" height="115" as="geometry" />
        </mxCell>
        <mxCell id="lok_db" value="&lt;b&gt;SQLite&lt;/b&gt; (data/parking.db)&lt;br&gt;miejsca, historia_zmian, alerty,&lt;br&gt;odrzucone_komunikaty,&lt;br&gt;oblozenie_stref, uzytkownicy&lt;br&gt;&lt;i&gt;albo Azure SQL przez DATABASE_URL&lt;br&gt;(sprawdzone 24.11.2026, strona 2)&lt;/i&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#d5e8d4;strokeColor=#5b8f45;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="660" y="330" width="240" height="140" as="geometry" />
        </mxCell>
        <mxCell id="lok_web" value="&lt;b&gt;Aplikacja web + API&lt;/b&gt;&lt;br&gt;(Flask, :8000)&lt;br&gt;F03: tablica /&lt;br&gt;F04: mapa /mapa&lt;br&gt;F05: panel /panel,&lt;br&gt;historia 7 dni" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#d5e8d4;strokeColor=#5b8f45;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="965" y="330" width="175" height="140" as="geometry" />
        </mxCell>
        <mxCell id="lok_drv" value="&lt;b&gt;Kierowca&lt;/b&gt;: tablica i mapa&lt;br&gt;&lt;i&gt;tylko odczyt, bez logowania&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="705" y="650" width="200" height="80" as="geometry" />
        </mxCell>
