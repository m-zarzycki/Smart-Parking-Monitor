        <mxCell id="lok_sub" value="System monitorowania zajętości miejsc parkingowych przy budynku uczelni&lt;br&gt;Grupa 2 • Radosław Sieroń, Michał Zarzycki • LAB10, 24.11.2026 • status: wdrożone, 67 testów, K1–K5 spełnione; zapis sprawdzony też w Azure SQL" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=2;fontSize=11;fontSize=11;fontColor=#444444;" vertex="1" parent="1">
