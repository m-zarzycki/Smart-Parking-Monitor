        <mxCell id="d_r1" value="&lt;b&gt;Odrzuć rekord&lt;/b&gt;&lt;br&gt;Odbiornik: wpis w Odrzucone komunikaty (powód, czas odebrania); stan i licznik bez zmian" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=10;" vertex="1" parent="1">
