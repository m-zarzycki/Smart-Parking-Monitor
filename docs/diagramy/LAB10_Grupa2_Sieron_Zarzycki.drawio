        <mxCell id="kontekst_e3" value="wolne miejsca w strefach A/B/C&lt;br&gt;(liczba / PEŁNA / BRAK DANYCH),&lt;br&gt;mapa, czas aktualizacji" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;strokeWidth=1.3;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=1;exitY=0.3152;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="k_sys" target="k_drv">
