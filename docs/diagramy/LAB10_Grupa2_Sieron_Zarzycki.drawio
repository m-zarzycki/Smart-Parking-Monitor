        <mxCell id="kontekst_e5" value="alert o braku danych z czujnika,&lt;br&gt;historia obłożenia stref (7 dni)" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;strokeWidth=1.3;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=1;exitY=0.9212;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="k_sys" target="k_mgr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k_scope" value="&lt;b&gt;System obejmuje&lt;/b&gt; czujniki z ESP32 (w prototypie symulator 90 miejsc), odbiór i zapis danych w chmurze (prototyp lokalny: broker Mosquitto, odbiornik w Pythonie, SQLite; wariant docelowy: Azure), liczniki wolnych miejsc w strefach na tablicy przy wjeździe (w prototypie widok w aplikacji), mapę w aplikacji webowej oraz alerty o braku danych dla zarządcy.&lt;br&gt;&lt;br&gt;&lt;b&gt;Poza zakresem pozostaje:&lt;/b&gt; rezerwacje i płatności, rozpoznawanie tablic rejestracyjnych, nawigacja do konkretnego miejsca, obsługa wielu parkingów, fizyczny montaż i zasilanie czujników." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fillColor=#f7f7f7;strokeColor=#bdbdbd;align=left;verticalAlign=top;spacing=6;fontSize=10.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="525" width="1110" height="80" as="geometry" />
        </mxCell>
        <mxCell id="k_dec" value="&lt;b&gt;Decyzja o granicy:&lt;/b&gt; czujniki i ESP32 są częścią rozwiązania, bo to my ustalamy regułę 3 s i format komunikatu. Dlatego leżą wewnątrz granicy systemu, a w prototypie zastępuje je symulator. Chmura to platforma, na której działa system; jej komponenty pokazują strony 2 (Azure) i 2b (wariant lokalny). Kierowca i zarządca wynikają z karty LAB02 (cz. 4), a pojazd jest zjawiskiem, które system mierzy. &lt;b&gt;LAB10:&lt;/b&gt; aktorzy i granica bez zmian względem LAB05." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fillColor=#f7f7f7;strokeColor=#bdbdbd;align=left;verticalAlign=top;spacing=6;fontSize=10.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="620" width="1110" height="56" as="geometry" />
        </mxCell>
        <mxCell id="k_foot" value="Każda strzałka pokazuje kierunek przekazania informacji. Na kontekście nie podajemy jeszcze usług ani protokołów (strona 2)." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=2;fontSize=11;fontSize=10;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="30" y="690" width="1110" height="20" as="geometry" />
