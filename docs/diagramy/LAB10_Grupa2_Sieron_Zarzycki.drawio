        <mxCell id="architektura_e8" value="HTTPS + konto:&lt;br&gt;logowanie, historia,&lt;br&gt;potwierdzenie alertu" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;strokeWidth=1.3;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=0.55;exitY=0;exitDx=0;exitDy=0;entryX=0.4865;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_mgb" target="a_app">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-36" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="architektura_e9" value="alerty,&lt;br&gt;historia 7 dni" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;strokeWidth=1.3;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=0.87;exitY=1;exitDx=0;exitDy=0;entryX=0.905;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_app" target="a_mgb">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="45" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a_test" value="&lt;b&gt;Test 24.11.2026 (wykonany):&lt;/b&gt; odbiornik lokalny ze strony 2b (komputer zespołu: symulator → Mosquitto → python -m parking start) zapisuje do tej bazy przez ODBC Driver 18 (TLS, port 1433). Wynik w Edytorze zapytań: 90 miejsc w strefach A, B, C, historia zmian rośnie (źródło ZMIANA). Czasy w UTC: 18:03 w bazie = 19:03 czasu polskiego (CET)." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fillColor=#f3f9f1;strokeColor=#5b8f45;strokeWidth=1.2;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="345" y="268" width="290" height="100" as="geometry" />
        </mxCell>
        <mxCell id="architektura_e10" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=7;strokeColor=#5b8f45;strokeWidth=1.5;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_test" target="a_sql">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a_fn" value="&lt;b&gt;Funkcje (karta LAB02, cz. 5)&lt;/b&gt;&lt;br&gt;F01 wykrywanie zajętości z filtrem 3 s&lt;br&gt;F02 zapis stanu i historii zmian&lt;br&gt;F03 licznik wolnych miejsc w strefie&lt;br&gt;F04 mapa parkingu w aplikacji&lt;br&gt;F05 alert o braku sygnału, historia" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fillColor=#f7f7f7;strokeColor=#bdbdbd;align=left;verticalAlign=top;spacing=6;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="18" y="566" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a_sec" value="&lt;b&gt;Kontrola dostępu&lt;/b&gt;&lt;br&gt;• urządzenie → IoT Hub: tożsamość urządzenia w rejestrze IoT Hub&lt;br&gt;• funkcje i aplikacja → baza: tożsamość zarządzana, bez haseł w kodzie&lt;br&gt;• test 24.11.2026: login SQL tylko w lokalnym .env, zapora na IP zespołu&lt;br&gt;• zarządca: logowanie na konto z rolą; kierowca: tylko odczyt" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fillColor=#f7f7f7;strokeColor=#bdbdbd;align=left;verticalAlign=top;spacing=6;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="330" y="566" width="350" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a_foot" value="Strzałki pokazują kierunek głównej operacji i nie są dowodem wdrożenia. Klucze urządzeń, hasła i connection strings są poza repozytorium i poza diagramem (ustawienia aplikacji / Azure Key Vault)." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=2;fontSize=11;fontSize=10;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="18" y="676" width="662" height="48" as="geometry" />
        </mxCell>
        <mxCell id="a_same" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fillColor=#f7f7f7;strokeColor=#bdbdbd;align=left;verticalAlign=top;spacing=6;fontSize=10.5;fontSize=10;" value="&lt;b&gt;LAB10:&lt;/b&gt; logika jest wspólna z wariantem lokalnym (strona 2b) – pakiet &lt;i&gt;parking&lt;/i&gt;, klasa ParkingService. Różnią się tylko adaptery: IoT Hub zamiast Mosquitto, funkcje zamiast procesu odbiornika, Azure SQL zamiast SQLite.">
          <mxGeometry x="18" y="730" width="662" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
