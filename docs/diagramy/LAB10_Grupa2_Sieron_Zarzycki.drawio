        <mxCell id="d_lane" value="Alarm F05: kontrola braku danych (Kontrola co 10 s – wątek lokalnie / timer w Azure)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fillColor=none;strokeColor=#7a7a7a;strokeWidth=1.2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;fontStyle=1;fontColor=#4a4a4a;" vertex="1" parent="1">
          <mxGeometry x="600" y="470" width="550" height="230" as="geometry" />
        </mxCell>
        <mxCell id="d_k1" value="&lt;b&gt;W1. Kontrola&lt;/b&gt;&lt;br&gt;czas od ostatniego komunikatu (wg czasu odebrania w chmurze)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#d5e8d4;strokeColor=#5b8f45;strokeWidth=1.5;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="615" y="510" width="140" height="86" as="geometry" />
        </mxCell>
        <mxCell id="d_dk" value="&amp;gt; 3 min bez&lt;br&gt;komunikatu?" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#ffffff;strokeColor=#5b8f45;strokeWidth=1.5;spacing=2;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="800" y="495" width="140" height="115" as="geometry" />
        </mxCell>
        <mxCell id="d_k2" value="&lt;b&gt;W2. BRAK DANYCH&lt;/b&gt;&lt;br&gt;stan + wpis w historii; 1 alert (jeśli brak aktywnego); miejsce szare, nie liczy się jako wolne" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#d5e8d4;strokeColor=#5b8f45;strokeWidth=1.5;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="985" y="495" width="155" height="108" as="geometry" />
        </mxCell>
        <mxCell id="d_k3" value="&lt;b&gt;W3. Zarządca&lt;/b&gt; widzi alert w panelu, potwierdza go i zleca naprawę czujnika &lt;i&gt;(krok ręczny)&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#fff2cc;strokeColor=#b8962e;dashed=1;dashPattern=6 3;strokeWidth=1.5;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="985" y="635" width="155" height="58" as="geometry" />
        </mxCell>
        <mxCell id="przeplyw_e16" value="czas" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;strokeWidth=1.3;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_k1" target="d_dk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="przeplyw_e17" value="TAK" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;strokeWidth=1.3;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_dk" target="d_k2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="przeplyw_e18" value="NIE: kolejna kontrola za 10 s" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;strokeWidth=1.3;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_dk" target="d_k1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="870" y="650" />
              <mxPoint x="685" y="650" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="przeplyw_e19" value="alert" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;strokeWidth=1.3;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_k2" target="d_k3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_sit" value="&lt;table style='border-collapse:collapse;width:100%;font-size:10px' border='1' cellpadding='3'&gt;&lt;tr style='background:#e8eef7'&gt;&lt;th style='width:24%'&gt;Sytuacja&lt;/th&gt;&lt;th&gt;Co się dzieje&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Prawidłowy rekord&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Odbiornik zapisuje go w bazie (Miejsca, Historia zmian); kierowca widzi nowy licznik na tablicy i mapie w ciągu 5 s.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Błędna wartość lub brak czasu&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Odbiornik odrzuca rekord i zapisuje go w Odrzucone komunikaty z powodem; stan miejsca i licznik bez zmian.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Brak połączenia / nowych danych&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Bufor na ESP32 nie jest założony (ograniczenie prototypu). Po 3 min: BRAK DANYCH, szare miejsce, 1 alert; mapa pokazuje czas ostatniej aktualizacji. Po powrocie sieci heartbeat (≤ 60 s) przywraca stan i zamyka alert.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=2;fontSize=11;fontSize=10;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="615" width="565" height="150" as="geometry" />
        </mxCell>
        <mxCell id="d_rec" value="&lt;b&gt;Przykład rekordu (krok 2, scenariusz 1 z LAB02):&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;{&amp;quot;spot_id&amp;quot;:&amp;quot;B03&amp;quot;, &amp;quot;zone&amp;quot;:&amp;quot;B&amp;quot;, &amp;quot;state&amp;quot;:&amp;quot;ZAJĘTE&amp;quot;, &amp;quot;distance_cm&amp;quot;:60,&lt;br&gt;&amp;nbsp;&amp;quot;msg_type&amp;quot;:&amp;quot;ZMIANA&amp;quot;, &amp;quot;event_time_utc&amp;quot;:&amp;quot;2026-11-24T08:00:03Z&amp;quot;}&lt;/font&gt;&amp;nbsp;&amp;nbsp;(09:00:03 czasu lokalnego)&lt;br&gt;&lt;b&gt;Rekord błędny:&lt;/b&gt; spot_id spoza A01–C30, zone niezgodna, state ≠ ZAJĘTE/WOLNE, msg_type ≠ ZMIANA/HEARTBEAT, brak event_time_utc lub &amp;gt; 1 min w przyszłości, distance_cm &amp;lt; 0 lub &amp;gt; 450; &lt;b&gt;LAB10:&lt;/b&gt; temat MQTT / urządzenie niezgodne z miejscem, komunikat starszy niż ostatnio przyjęty, JSON &amp;gt; 1 KB." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fillColor=#f7f7f7;strokeColor=#bdbdbd;align=left;verticalAlign=top;spacing=6;fontSize=10.5;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="706" width="550" height="96" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
