        <mxCell id="architektura_e1" value="JSON / MQTT&lt;br&gt;przez TLS (8883)&lt;br&gt;tożsamość&lt;br&gt;urządzenia" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;strokeWidth=1.3;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;exitX=1;exitY=0.4444;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_sim" target="a_hub">
