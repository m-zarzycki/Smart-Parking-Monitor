        <mxCell id="a_sim" value="&lt;b&gt;Symulator czujników&lt;/b&gt; (Python)&lt;br&gt;F01: ZMIANA i HEARTBEAT,&lt;br&gt;90 miejsc, reguła 3 s&lt;br&gt;&lt;i&gt;--wyjscie iothub&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#d5e8d4;strokeColor=#5b8f45;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="32" y="135" width="186" height="135" as="geometry" />
        </mxCell>
        <mxCell id="a_esp" value="&lt;b&gt;Czujnik ultradźwiękowy + ESP32&lt;/b&gt;&lt;br&gt;&lt;i&gt;docelowo zamiast symulatora&lt;/i&gt;&lt;br&gt;F01: pomiar co 0,5 s, zatwierdzenie stanu po 3 s" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#f1f5fb;strokeColor=#7d9cc7;dashed=1;dashPattern=6 3;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="32" y="300" width="186" height="130" as="geometry" />
        </mxCell>
        <mxCell id="a_hub" value="&lt;b&gt;Azure IoT Hub&lt;/b&gt; (Free F1)&lt;br&gt;F02: przyjmuje komunikaty,&lt;br&gt;rejestr tożsamości urządzeń" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#dae8fc;strokeColor=#3d6aa8;dashed=1;dashPattern=6 3;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="330" y="140" width="195" height="110" as="geometry" />
        </mxCell>
        <mxCell id="a_rcv" value="&lt;b&gt;Funkcja Odbiornik&lt;/b&gt;&lt;br&gt;(Azure Functions, wyzwalacz IoT Hub)&lt;br&gt;F02: waliduje rekord, porównuje stan z bazą, zapisuje&lt;br&gt;&lt;i&gt;function_app.py → ParkingService&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#dae8fc;strokeColor=#3d6aa8;dashed=1;dashPattern=6 3;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="660" y="140" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="a_lim" value="&lt;b&gt;Ograniczenie:&lt;/b&gt; IoT Hub Free = 8 000 komunikatów na dobę. 90 miejsc × heartbeat co 60 s to ok. 130 000 na dobę, więc w F1 mieszczą się tylko krótkie testy (ok. 1,5 h). Praca ciągła wymaga warstwy B1 lub S1 (400 000 na dobę)." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fillColor=#f7f7f7;strokeColor=#bdbdbd;align=left;verticalAlign=top;spacing=6;fontSize=10.5;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="905" y="135" width="235" height="82" as="geometry" />
        </mxCell>
        <mxCell id="a_chk" value="&lt;b&gt;Funkcja Kontrola braku danych&lt;/b&gt;&lt;br&gt;(Azure Functions, timer co 10 s)&lt;br&gt;F05: po &amp;gt; 3 min: BRAK DANYCH + 1 alert; co 5 min próbka obłożenia&lt;br&gt;&lt;i&gt;function_app.py → ParkingService&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#dae8fc;strokeColor=#3d6aa8;dashed=1;dashPattern=6 3;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="300" y="395" width="225" height="135" as="geometry" />
        </mxCell>
        <mxCell id="a_sql" value="&lt;b&gt;Azure SQL Database&lt;/b&gt;&lt;br&gt;&lt;i&gt;wdrożona, sprawdzona 24.11.2026&lt;/i&gt;&lt;br&gt;Miejsca, Historia zmian, Alerty, Odrzucone komunikaty, Obłożenie stref&lt;br&gt;&lt;i&gt;sql/azuresql.sql • czasy w UTC&lt;/i&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#d5e8d4;strokeColor=#5b8f45;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="660" y="395" width="200" height="135" as="geometry" />
        </mxCell>
        <mxCell id="a_app" value="&lt;b&gt;Aplikacja webowa + API&lt;/b&gt;&lt;br&gt;(Azure App Service,&lt;br&gt;gunicorn parking.wsgi)&lt;br&gt;F03: liczniki stref&lt;br&gt;F04: mapa 90 miejsc&lt;br&gt;F05: alerty, historia 7 dni" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#dae8fc;strokeColor=#3d6aa8;dashed=1;dashPattern=6 3;strokeWidth=1.5;" vertex="1" parent="1">
