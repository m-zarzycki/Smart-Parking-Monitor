        <mxCell id="erd_lg3" value="odrzucenie / błąd" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=10;spacing=1;" vertex="1" parent="1">
