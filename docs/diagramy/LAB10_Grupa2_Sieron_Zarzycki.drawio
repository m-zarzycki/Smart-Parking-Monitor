        <mxCell id="k_sys" value="&lt;b style='font-size:13px'&gt;SYSTEM MONITOROWANIA ZAJĘTOŚCI&lt;br&gt;MIEJSC PARKINGOWYCH&lt;/b&gt;&lt;br&gt;&lt;br&gt;Liczniki wolnych miejsc w strefach A, B, C&lt;br&gt;(tablica przy wjeździe), mapa 90 miejsc,&lt;br&gt;historia obłożenia i alerty o braku danych&lt;br&gt;&lt;br&gt;&lt;i&gt;W granicy: czujniki z ESP32 (w prototypie&lt;br&gt;symulator), chmura (prototyp: Mosquitto +&lt;br&gt;Python + SQLite; docelowo Azure), aplikacja webowa&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#d5e8d4;strokeColor=#5b8f45;strokeWidth=1.5;strokeWidth=3;fontSize=11.5;" vertex="1" parent="1">
