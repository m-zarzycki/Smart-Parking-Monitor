        </mxCell>
        <mxCell id="lok_map" value="&lt;b&gt;Wariant lokalny ↔ Azure (strona 2)&lt;/b&gt;&lt;br&gt;Mosquitto ↔ Azure IoT Hub&lt;br&gt;MqttReceiver ↔ funkcja Odbiornik&lt;br&gt;SilenceChecker ↔ funkcja Kontrola (timer)&lt;br&gt;SQLite ↔ Azure SQL Database (sprawdzone)&lt;br&gt;Flask (python -m parking web) ↔ App Service (gunicorn)&lt;br&gt;&lt;i&gt;Wspólny kod: parking.service.ParkingService&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fillColor=#f7f7f7;strokeColor=#bdbdbd;align=left;verticalAlign=top;spacing=6;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="18" y="560" width="330" height="140" as="geometry" />
        </mxCell>
        <mxCell id="lok_sec" value="&lt;b&gt;Kontrola dostępu&lt;/b&gt;&lt;br&gt;• broker: brak anonimowych, ACL: symulator zapis, odbiornik odczyt, czujnik tylko swój temat&lt;br&gt;• odbiornik: temat musi zgadzać się z spot_id, rozmiar ≤ 1 KB&lt;br&gt;• web: kierowca odczyt; zarządca konto z rolą&lt;br&gt;• hasła tylko w .env / passwd (poza repozytorium)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fillColor=#f7f7f7;strokeColor=#bdbdbd;align=left;verticalAlign=top;spacing=6;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="360" y="560" width="320" height="140" as="geometry" />
        </mxCell>
        <mxCell id="lok_foot" value="Tryb awaryjny na prezentację: &lt;i&gt;python -m parking demo&lt;/i&gt; – symulator w procesie aplikacji, bez brokera (omija MQTT; nie jest architekturą docelową)." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=2;fontSize=11;fontSize=10;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="18" y="712" width="662" height="40" as="geometry" />
