        <mxCell id="d_s3" value="&lt;b&gt;3. Transmisja i odbiór&lt;/b&gt;&lt;br&gt;lokalnie: MQTT → Mosquitto → Odbiornik&lt;br&gt;Azure: MQTT/TLS → IoT Hub → funkcja Odbiornik" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#d5e8d4;strokeColor=#5b8f45;strokeWidth=1.5;fontSize=10.5;" vertex="1" parent="1">
