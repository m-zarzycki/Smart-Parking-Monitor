        <mxCell id="architektura_e2" value="to samo&lt;br&gt;połączenie&lt;br&gt;(docelowo)" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;strokeWidth=1.3;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;dashed=1;dashPattern=5 4;strokeColor=#7d9cc7;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0.15;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_esp" target="a_hub">
