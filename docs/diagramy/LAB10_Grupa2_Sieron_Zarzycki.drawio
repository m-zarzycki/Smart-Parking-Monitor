        <mxCell id="architektura_e4" value="&lt;b&gt;zapis&lt;/b&gt; poprawnego rekordu:&lt;br&gt;Miejsca, Historia zmian;&lt;br&gt;odrzuconego: Odrzucone komunikaty&lt;br&gt;&lt;i&gt;tożsamość zarządzana funkcji&lt;/i&gt;" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;strokeWidth=1.3;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;strokeWidth=2.6;strokeColor=#1f3f73;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_rcv" target="a_sql">
