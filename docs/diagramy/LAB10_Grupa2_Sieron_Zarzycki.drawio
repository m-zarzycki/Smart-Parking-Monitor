        <mxCell id="erd_t_m" value="&lt;div style='background:#d5e8d4;padding:4px 6px;border-bottom:1px solid #5b8f45'&gt;&lt;b&gt;miejsca&lt;/b&gt;&lt;/div&gt;&lt;div style='padding:1px 6px'&gt;&lt;b&gt;PK&lt;/b&gt; spot_id (A01–C30)&lt;/div&gt;&lt;div style='padding:1px 6px'&gt;strefa (A/B/C)&lt;/div&gt;&lt;div style='padding:1px 6px'&gt;stan (ZAJĘTE / WOLNE / BRAK DANYCH)&lt;/div&gt;&lt;div style='padding:1px 6px'&gt;odleglosc_cm&lt;/div&gt;&lt;div style='padding:1px 6px'&gt;czas_zdarzenia (wg czujnika)&lt;/div&gt;&lt;div style='padding:1px 6px'&gt;czas_ostatniego_komunikatu (odebrania)&lt;/div&gt;&lt;div style='padding:1px 6px'&gt;czas_zmiany_stanu&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;align=left;verticalAlign=top;spacing=0;fontSize=10;fillColor=#ffffff;strokeColor=#5b8f45;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="290" height="132" as="geometry" />
        </mxCell>
        <mxCell id="erd_t_h" value="&lt;div style='background:#d5e8d4;padding:4px 6px;border-bottom:1px solid #5b8f45'&gt;&lt;b&gt;historia_zmian&lt;/b&gt;&lt;/div&gt;&lt;div style='padding:1px 6px'&gt;&lt;b&gt;PK&lt;/b&gt; id&lt;/div&gt;&lt;div style='padding:1px 6px'&gt;&lt;b&gt;FK&lt;/b&gt; spot_id → miejsca&lt;/div&gt;&lt;div style='padding:1px 6px'&gt;strefa&lt;/div&gt;&lt;div style='padding:1px 6px'&gt;nowy_stan&lt;/div&gt;&lt;div style='padding:1px 6px'&gt;czas_zmiany&lt;/div&gt;&lt;div style='padding:1px 6px'&gt;czas_odebrania&lt;/div&gt;&lt;div style='padding:1px 6px'&gt;zrodlo (ZMIANA / HEARTBEAT / KONTROLA / START)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;align=left;verticalAlign=top;spacing=0;fontSize=10;fillColor=#ffffff;strokeColor=#5b8f45;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="430" y="110" width="300" height="132" as="geometry" />
        </mxCell>
        <mxCell id="erd_t_a" value="&lt;div style='background:#d5e8d4;padding:4px 6px;border-bottom:1px solid #5b8f45'&gt;&lt;b&gt;alerty&lt;/b&gt;&lt;/div&gt;&lt;div style='padding:1px 6px'&gt;&lt;b&gt;PK&lt;/b&gt; id&lt;/div&gt;&lt;div style='padding:1px 6px'&gt;&lt;b&gt;FK&lt;/b&gt; spot_id → miejsca&lt;/div&gt;&lt;div style='padding:1px 6px'&gt;czas_ostatniego_komunikatu (przed przerwą)&lt;/div&gt;&lt;div style='padding:1px 6px'&gt;czas_otwarcia&lt;/div&gt;&lt;div style='padding:1px 6px'&gt;czas_zamkniecia (NULL = aktywny)&lt;/div&gt;&lt;div style='padding:1px 6px'&gt;czas_potwierdzenia, potwierdzil&lt;/div&gt;&lt;div style='padding:1px 6px'&gt;&lt;i&gt;UNIQUE (spot_id) WHERE czas_zamkniecia IS NULL&lt;/i&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;align=left;verticalAlign=top;spacing=0;fontSize=10;fillColor=#ffffff;strokeColor=#5b8f45;strokeWidth=1.5;" vertex="1" parent="1">
