# Wzór konfiguracji. Skopiuj jako .env i uzupełnij hasła lokalnie.
# Plik .env jest w .gitignore – nie oddawaj go i nie wklejaj haseł do dokumentacji.

# --- Baza danych -----------------------------------------------------------------------
DATABASE_URL=sqlite:///data/parking.db
# Azure SQL z LAB1 (logowanie kontem Microsoft Entra, bez hasła w pliku):
# DATABASE_URL=mssql://Driver={ODBC Driver 18 for SQL Server};Server=tcp:<SERWER>.database.windows.net,1433;Database=<BAZA>;Encrypt=yes;TrustServerCertificate=no;Authentication=ActiveDirectoryInteractive

# --- Broker MQTT (Mosquitto) -------------------------------------------------------------
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TLS=false
MQTT_CA_FILE=
MQTT_SENSOR_USER=czujniki
MQTT_SENSOR_PASSWORD=
MQTT_RECEIVER_USER=odbiornik
MQTT_RECEIVER_PASSWORD=

# --- Aplikacja web --------------------------------------------------------------------------
WEB_HOST=127.0.0.1
WEB_PORT=8000
# Wygeneruj: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
SESSION_COOKIE_SECURE=false

# --- Wspólne ----------------------------------------------------------------------------------
GATEWAY_IDS=symulator-01
LOG_LEVEL=INFO

# --- Tryb Azure: symulator -> Azure IoT Hub -----------------------------------------------------
IOTHUB_DEVICE_CONNECTION_STRING=
IOTHUB_MAX_MESSAGES=7000
